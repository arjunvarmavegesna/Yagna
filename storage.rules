rules_version = '2';

// Firebase Storage security for Stock Loader / Audit Tool photos.
// Mirrors database.rules.json: deny by default, and only allow a signed-in (anonymous)
// user who already knows the session code to read/write that session's photos.
// Security comes from Anonymous Auth + not being able to enumerate session codes.
service firebase.storage {
  match /b/{bucket}/o {

    // Shared Stock Loader session photos: stock_sessions/<code>/<entryKey>/<n>.jpg
    match /stock_sessions/{code}/{photo=**} {
      allow read:  if request.auth != null;
      // Writes must be authenticated images under 3 MB (compressed JPEGs are ~50–400 KB).
      allow write: if request.auth != null
                   && request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Everything else is denied (no matching allow rule = blocked).
  }
}
