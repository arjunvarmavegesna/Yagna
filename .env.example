# Copy these into your Vercel project's Environment Variables (Settings → Environment Variables).
# Do NOT commit a real .env file — it stays local only (see .gitignore).

# Your Anthropic API key (the one shared pharmacy key). Stays server-side, never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# The shared passcode pharmacy staff type into the app's "Pharmacy Access Code" prompt.
# Pick something non-obvious; you can rotate it anytime by changing it here and redeploying.
ACCESS_CODE=change-me-to-a-pharmacy-passcode

# Optional model overrides (defaults are set in api/anthropic.js).
# CLAUDE_TEXT_MODEL=claude-sonnet-4-6
# CLAUDE_VISION_MODEL=claude-opus-4-8
# MAX_TOKENS_CEILING=4000
